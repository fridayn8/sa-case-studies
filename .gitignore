# .gitignore — this is a documentation repository: keep secrets and local noise out.

# ---- Secrets & credentials (never commit these) -----------------------------
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.age
age-key.txt
.env
.env.*
!.env.example
*.secret

# ---- Tooling output ---------------------------------------------------------
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
site/
dist/
build/

# ---- OS / editor noise ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local agent files: personal notes and permissions, never committed
CLAUDE.local.md
.claude/settings.local.json

# Personal agent skills: create them as .claude/skills/private-<name>/ and they stay local
.claude/skills/private-*/
